# Optional defaults for direct Alchemy CLI use.
# Cloudflare authentication is stored in ~/.alchemy after `alchemy login`.
ALCHEMY_STAGE=dev
RUM_SAMPLE_RATE=1
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_STUDIO_URL=
SANITY_API_READ_TOKEN=
SANITY_PREVIEW_COOKIE_SECRET=
SANITY_WEBHOOK_SECRET=
# Managed by alchemy.run.ts: staging/production=1, local/dev=0.
NOTIFICATIONS_REQUIRED=0
# Private recipient for cloudflare:alerts:policy; never printed by the command.
CLOUDFLARE_ALERT_EMAIL=
