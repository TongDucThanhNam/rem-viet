{
  "name": "@agency/cms-provider-sanity",
  "version": "0.1.0-experimental.1",
  "private": true,
  "type": "module",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./hosted": {
      "types": "./src/hosted-conformance.ts",
      "default": "./src/hosted-conformance.ts"
    },
    "./presentation": {
      "types": "./src/presentation-conformance.ts",
      "default": "./src/presentation-conformance.ts"
    },
    "./promotion": {
      "types": "./src/promotion-conformance.ts",
      "default": "./src/promotion-conformance.ts"
    },
